pragma solidity ^0.8.24;

import {IERC721} from "./interfaces/IERC721.sol";
import {IERC721Receiver} from "./interfaces/IERC721Receiver.sol";

/// A small, complete ERC-721 base. You do not edit this file: read it, then build on it.
/// Subclasses override `_beforeTransfer` to add rules. It runs on every mint and every transfer,
/// including transfers made by an approved operator.
abstract contract ERC721Minimal is IERC721 {
    error ZeroAddress();
    error NoSuchToken(uint256 id);
    error AlreadyMinted(uint256 id);
    error NotAuthorized();
    error WrongOwner();
    error UnsafeRecipient(address to);

    mapping(uint256 => address) private _owners;
    mapping(address => uint256) private _balances;
    mapping(uint256 => address) private _approved;
    mapping(address => mapping(address => bool)) private _operators;

    function supportsInterface(bytes4 id) external pure returns (bool) {
        return id == 0x01ffc9a7 || id == 0x80ac58cd;
    }

    function balanceOf(address owner) external view returns (uint256) {
        if (owner == address(0)) revert ZeroAddress();
        return _balances[owner];
    }

    function ownerOf(uint256 id) public view returns (address owner) {
        owner = _owners[id];
        if (owner == address(0)) revert NoSuchToken(id);
    }

    function approve(address to, uint256 id) external {
        address owner = ownerOf(id);
        if (msg.sender != owner && !_operators[owner][msg.sender]) revert NotAuthorized();
        _approved[id] = to;
        emit Approval(owner, to, id);
    }

    function getApproved(uint256 id) external view returns (address) {
        ownerOf(id);
        return _approved[id];
    }

    function setApprovalForAll(address operator, bool approved) external {
        _operators[msg.sender][operator] = approved;
        emit ApprovalForAll(msg.sender, operator, approved);
    }

    function isApprovedForAll(address owner, address operator) external view returns (bool) {
        return _operators[owner][operator];
    }

    function transferFrom(address from, address to, uint256 id) public {
        address owner = ownerOf(id);
        if (owner != from) revert WrongOwner();
        if (msg.sender != owner && !_operators[owner][msg.sender] && _approved[id] != msg.sender) revert NotAuthorized();
        _transfer(from, to, id);
    }

    function safeTransferFrom(address from, address to, uint256 id) external {
        safeTransferFrom(from, to, id, "");
    }

    function safeTransferFrom(address from, address to, uint256 id, bytes memory data) public {
        transferFrom(from, to, id);
        if (to.code.length == 0) return;
        try IERC721Receiver(to).onERC721Received(msg.sender, from, id, data) returns (bytes4 ret) {
            if (ret != IERC721Receiver.onERC721Received.selector) revert UnsafeRecipient(to);
        } catch {
            revert UnsafeRecipient(to);
        }
    }

    /// Creates token `id` for `to`. Runs `_beforeTransfer(address(0), to, id)` first.
    function _mint(address to, uint256 id) internal {
        if (to == address(0)) revert ZeroAddress();
        if (_owners[id] != address(0)) revert AlreadyMinted(id);
        _beforeTransfer(address(0), to, id);
        _owners[id] = to;
        _balances[to] += 1;
        emit Transfer(address(0), to, id);
    }

    /// Moves token `id` from `from` to `to`. Checks nothing about who is calling. Runs `_beforeTransfer` first.
    function _transfer(address from, address to, uint256 id) internal {
        if (to == address(0)) revert ZeroAddress();
        _beforeTransfer(from, to, id);
        delete _approved[id];
        _balances[from] -= 1;
        _balances[to] += 1;
        _owners[id] = to;
        emit Transfer(from, to, id);
    }

    /// Hook for subclasses. Revert here to block a mint or transfer.
    function _beforeTransfer(address from, address to, uint256 id) internal virtual {}
}
