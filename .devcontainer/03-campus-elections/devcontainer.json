{
  "name": "Workshop 03: Secure Campus Elections",
  "build": { "dockerfile": "../Dockerfile" },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/labs/03-campus-elections",
  "customizations": {
    "codespaces": { "openFiles": ["README.md", "src/Election.sol"] },
    "vscode": {
      "extensions": ["NomicFoundation.hardhat-solidity"],
      "settings": { "files.exclude": { ".solution": true, "out": true, "cache": true } }
    }
  },
  "postAttachCommand": "forge build --silent && echo 'Run: forge test'"
}
