---
import "../styles/global.css";
import { repo, socials } from "../data";

interface Props { title: string; description?: string; current?: "home" | "docs" | "labs" }
const { title, description = "Applied blockchain engineering for civic infrastructure, from Ashesi University.", current } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  { id: "docs", label: "Docs", href: `${base}docs/` },
  { id: "labs", label: "Labs", href: `${base}labs/` },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}mark.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline src={`${base}theme.js`}></script>
  </head>
  <body>
    <header class="header">
      <div class="header-inner">
        <a class="brand" href={base}>
          <img class="logo-img" src={`${base}mark.png`} alt="" width="46" height="22" />
          <span>Ashesi Blockchain Community</span>
        </a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={current === n.id ? "page" : undefined}>{n.label}</a>)}
        </nav>
        <div class="header-actions">
          <a class="icon-btn gh" href={repo} aria-label="GitHub repository">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
          <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle theme">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></svg>
          </button>
        </div>
      </div>
    </header>

    <slot />

    <footer class="footer">
      <div class="container footer-inner">
        <span>Built by the Ashesi Blockchain Community. MIT licensed.</span>
        <nav class="socials" aria-label="Social">
          {socials.map((s) => <a href={s.href}>{s.name}</a>)}
        </nav>
      </div>
    </footer>
  </body>
</html>
