---
import type { Lab } from "../data";
interface Props { lab: Lab }
const { lab } = Astro.props;
const label = { live: "Live", remix: "In browser", soon: "Coming soon" }[lab.status];
---
<article class="card">
  <span class="meta">Workshop {String(lab.n).padStart(2, "0")} · {lab.phase}</span>
  <h3>{lab.title}</h3>
  <p>{lab.problem}</p>
  <div style="display:flex;gap:6px;flex-wrap:wrap">
    {lab.focus.map((f) => <code>{f}</code>)}
  </div>
  <div class="actions">
    {lab.status === "live" && (
      <>
        <a class="btn btn-primary" href={lab.href}>Open in Codespaces</a>
        <a class="btn btn-outline" href={lab.source}>Source</a>
      </>
    )}
    {lab.status === "remix" && <a class="btn btn-outline" href={lab.href}>Open Remix IDE</a>}
    {lab.status === "soon" && <span class="tag">{label}</span>}
  </div>
</article>
