---
import type labs from "../labs.json";
interface Props { lab: (typeof labs)[number] }
const { lab } = Astro.props;
const base = import.meta.env.BASE_URL;
const pretty = (id: string) => id.split("/").pop()!.replace(/-/g, " ");
---
<article class="card">
  <span class="meta">Lab {String(lab.n).padStart(2, "0")} · {lab.kind}</span>
  <h3>{lab.title}</h3>
  <p>{lab.summary}</p>
  <div style="display:flex;gap:6px;flex-wrap:wrap">
    {lab.concepts.map((c) => <code>{c}</code>)}
  </div>
  <p class="meta">Adapted from {lab.adaptedFrom}</p>
  {lab.docs.length > 0 && (
    <p class="meta">Lessons: {lab.docs.map((d, i) => (
      <>{i > 0 && ", "}<a href={`${base}docs/${d}/`}>{pretty(d)}</a></>
    ))}</p>
  )}
  <div class="actions">
    <a class="btn btn-primary" href={lab.codespaceUrl}>Open in Codespaces</a>
    <a class="btn btn-outline" href={lab.sourceUrl}>Source</a>
  </div>
</article>
