<svg viewBox="0 0 640 220" role="img" aria-labelledby="sf-t" font-family="var(--mono)" font-size="12">
  <title id="sf-t">Signing a message with a private key, then verifying the signature with the matching public key or address</title>
  <defs>
    <marker id="sf-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0 0L10 5L0 10z" fill="currentColor" />
    </marker>
  </defs>
  <g>
    <rect x="10" y="20" width="170" height="80" rx="8" fill="none" stroke="var(--border)" stroke-width="1.5" />
    <text x="22" y="42" fill="currentColor" font-weight="600">Signer (Ama)</text>
    <text x="22" y="64" fill="var(--muted-fg)">message</text>
    <text x="22" y="84" fill="var(--muted-fg)">private key (secret)</text>
  </g>
  <rect x="235" y="35" width="130" height="50" rx="8" fill="none" stroke="currentColor" stroke-width="1.5" />
  <text x="300" y="65" text-anchor="middle" fill="currentColor">sign()</text>
  <path d="M180 60 H233" fill="none" stroke="currentColor" stroke-width="1.5" marker-end="url(#sf-arrow)" />
  <path d="M365 60 H430" fill="none" stroke="currentColor" stroke-width="1.5" marker-end="url(#sf-arrow)" />
  <text x="398" y="50" text-anchor="middle" fill="var(--muted-fg)">signature</text>
  <g>
    <rect x="432" y="20" width="198" height="80" rx="8" fill="none" stroke="var(--border)" stroke-width="1.5" />
    <text x="444" y="42" fill="currentColor" font-weight="600">Anyone (Kofi)</text>
    <text x="444" y="64" fill="var(--muted-fg)">message + signature</text>
    <text x="444" y="84" fill="var(--muted-fg)">Ama's public key / address</text>
  </g>
  <path d="M530 100 V135" fill="none" stroke="currentColor" stroke-width="1.5" marker-end="url(#sf-arrow)" />
  <rect x="465" y="137" width="130" height="50" rx="8" fill="none" stroke="currentColor" stroke-width="1.5" />
  <text x="530" y="167" text-anchor="middle" fill="currentColor">verify()</text>
  <path d="M465 162 H340" fill="none" stroke="currentColor" stroke-width="1.5" marker-end="url(#sf-arrow)" />
  <text x="335" y="158" text-anchor="end" fill="currentColor">valid, or not</text>
  <text x="10" y="170" fill="var(--muted-fg)">The private key never leaves Ama.</text>
  <text x="10" y="190" fill="var(--muted-fg)">Change one letter of the message and verify() fails.</text>
</svg>
