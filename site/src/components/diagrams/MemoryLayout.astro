---
// Solidity's memory map: three reserved zones, then objects stacked from 0x80 upward.
const zones = [
  { y: 24, h: 56, a: "0x00 - 0x3f", t: "scratch space", n: "64 bytes, for hashing between statements" },
  { y: 84, h: 36, a: "0x40 - 0x5f", t: "free memory pointer", n: "holds 0x80 at the start" },
  { y: 124, h: 36, a: "0x60 - 0x7f", t: "zero slot", n: "start of empty arrays; never write" },
];
const objs = [
  { y: 164, a: "0x80", t: "length = 3", n: "new uint256[](3)" },
  { y: 192, a: "0xa0", t: "element 0", n: "" },
  { y: 220, a: "0xc0", t: "element 1", n: "" },
  { y: 248, a: "0xe0", t: "element 2", n: "" },
];
---
<svg viewBox="0 0 640 310" role="img" aria-labelledby="ml-t" font-family="var(--mono)" font-size="11">
  <title id="ml-t">Memory layout. Bytes 0x00 to 0x3f are scratch space, 0x40 to 0x5f hold the free memory pointer, 0x60 to 0x7f are the zero slot. Objects start at 0x80: an array of three uint256 values takes a length word and three element words, and afterwards the free memory pointer is 0x100.</title>
  <defs>
    <marker id="ml-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="var(--muted-fg)" />
    </marker>
  </defs>
  <text x="4" y="14" fill="var(--muted-fg)">address</text>
  <text x="130" y="14" fill="var(--muted-fg)">contents</text>
  <text x="330" y="14" fill="var(--muted-fg)">note</text>
  {zones.map((z) => (
    <g>
      <rect x="120" y={z.y} width="190" height={z.h} rx="4" fill="none" stroke="var(--border)" stroke-width="1.5" />
      <text x="4" y={z.y + z.h / 2 + 4} fill="var(--muted-fg)">{z.a}</text>
      <text x="130" y={z.y + z.h / 2 + 4} fill="currentColor" font-weight="600">{z.t}</text>
      <text x="330" y={z.y + z.h / 2 + 4} fill="var(--muted-fg)">{z.n}</text>
    </g>
  ))}
  {objs.map((o) => (
    <g>
      <rect x="120" y={o.y} width="190" height="26" rx="4" fill="none" stroke="var(--border)" stroke-width="1.5" />
      <text x="4" y={o.y + 17} fill="var(--muted-fg)">{o.a}</text>
      <text x="130" y={o.y + 17} fill="currentColor">{o.t}</text>
      <text x="330" y={o.y + 17} fill="var(--muted-fg)">{o.n}</text>
    </g>
  ))}
  <text x="4" y="296" fill="var(--muted-fg)">0x100</text>
  <text x="130" y="296" fill="currentColor" font-weight="600">next object goes here</text>
  <path d="M118 292 H100 V102 H116" stroke="var(--muted-fg)" stroke-width="1.5" fill="none" stroke-dasharray="4 3" marker-end="url(#ml-arrow)" />
  <text x="330" y="296" fill="var(--muted-fg)">the pointer at 0x40 is set to this address</text>
</svg>
