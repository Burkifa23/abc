---
// Where a mapping's values live: the slot of the mapping itself stays empty;
// each value sits at keccak256(key . slot).
const rows = [
  { k: "alice", s: "keccak256(alice . 2)", v: "100" },
  { k: "bob", s: "keccak256(bob . 2)", v: "25" },
  { k: "carol", s: "keccak256(carol . 2)", v: "0 (never written)" },
];
---
<svg viewBox="0 0 640 230" role="img" aria-labelledby="ss-t" font-family="var(--mono)" font-size="11">
  <title id="ss-t">A mapping declared in storage slot 2 keeps that slot empty. Each value is stored at a slot computed as keccak256 of the key joined with the slot number, so alice, bob and carol land in unrelated places, and an unwritten key reads as zero.</title>
  <rect x="4" y="12" width="190" height="70" rx="6" fill="none" stroke="var(--border)" stroke-width="1.5" />
  <text x="14" y="32" fill="var(--muted-fg)">slot 2</text>
  <text x="14" y="52" fill="currentColor" font-weight="600">mapping balances</text>
  <text x="14" y="70" fill="var(--muted-fg)">(slot itself stays empty)</text>
  <text x="230" y="18" fill="var(--muted-fg)">key</text>
  <text x="300" y="18" fill="var(--muted-fg)">slot = keccak256(key . 2)</text>
  <text x="540" y="18" fill="var(--muted-fg)">value</text>
  {rows.map((r, i) => (
    <path d={`M194 47 L226 ${48 + i * 48}`} stroke="var(--border)" stroke-width="1.5" fill="none" />
  ))}
  {rows.map((r, i) => (
    <g transform={`translate(0 ${28 + i * 48})`}>
      <rect x="226" y="0" width="408" height="40" rx="6" fill="none" stroke="var(--border)" stroke-width="1.5" />
      <text x="236" y="25" fill="currentColor" font-weight="600">{r.k}</text>
      <text x="300" y="25" fill="currentColor">{r.s}</text>
      <text x="540" y="25" fill="currentColor">{r.v}</text>
    </g>
  ))}
  <text x="4" y="216" fill="var(--muted-fg)">No key list is kept, so a mapping cannot be looped over or counted.</text>
</svg>
