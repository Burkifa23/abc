<svg viewBox="0 0 640 250" role="img" aria-labelledby="cvd-t" font-family="var(--mono)" font-size="11">
  <title id="cvd-t">Call versus delegatecall. With a normal call from A to B, B's code runs on B's storage and B sees msg.sender equal to A. With delegatecall, B's code runs on A's storage and msg.sender stays as the original caller.</title>
  <defs>
    <marker id="cvd-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0 0L10 5L0 10z" fill="currentColor" />
    </marker>
  </defs>
  <g transform="translate(4 8)">
    <text x="150" y="14" text-anchor="middle" fill="currentColor" font-weight="600">call</text>
    <rect x="0" y="30" width="90" height="70" rx="8" fill="none" stroke="var(--border)" stroke-width="1.5" />
    <text x="45" y="55" text-anchor="middle" fill="currentColor">A</text>
    <text x="45" y="75" text-anchor="middle" fill="var(--muted-fg)">own storage</text>
    <rect x="210" y="30" width="90" height="70" rx="8" fill="none" stroke="currentColor" stroke-width="2" />
    <text x="255" y="55" text-anchor="middle" fill="currentColor">B</text>
    <text x="255" y="75" text-anchor="middle" fill="var(--muted-fg)">own storage</text>
    <path d="M94 65 H206" fill="none" stroke="currentColor" stroke-width="1.5" marker-end="url(#cvd-arrow)" />
    <text x="150" y="58" text-anchor="middle" fill="currentColor">call</text>
    <text x="150" y="130" text-anchor="middle" fill="currentColor">B's code changes B's storage</text>
    <text x="150" y="150" text-anchor="middle" fill="var(--muted-fg)">msg.sender inside B = A</text>
  </g>
  <g transform="translate(330 8)">
    <text x="150" y="14" text-anchor="middle" fill="currentColor" font-weight="600">delegatecall</text>
    <rect x="0" y="30" width="90" height="70" rx="8" fill="none" stroke="currentColor" stroke-width="2" />
    <text x="45" y="55" text-anchor="middle" fill="currentColor">A</text>
    <text x="45" y="75" text-anchor="middle" fill="var(--muted-fg)">own storage</text>
    <rect x="210" y="30" width="90" height="70" rx="8" fill="none" stroke="var(--border)" stroke-width="1.5" />
    <text x="255" y="55" text-anchor="middle" fill="currentColor">B</text>
    <text x="255" y="75" text-anchor="middle" fill="var(--muted-fg)">code only</text>
    <path d="M94 65 H206" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="5 3" marker-end="url(#cvd-arrow)" />
    <text x="150" y="58" text-anchor="middle" fill="currentColor">delegate</text>
    <text x="150" y="130" text-anchor="middle" fill="currentColor">B's code changes A's storage</text>
    <text x="150" y="150" text-anchor="middle" fill="var(--muted-fg)">msg.sender inside = original caller</text>
  </g>
  <text x="4" y="205" fill="var(--muted-fg)">Bold border = the account whose storage is touched.</text>
  <text x="4" y="225" fill="var(--muted-fg)">Libraries rely on delegatecall: shared code, your own data.</text>
</svg>
