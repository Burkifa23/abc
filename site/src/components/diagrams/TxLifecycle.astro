---
const steps = [
  { t: "Wallet", d: "builds and signs the tx" },
  { t: "Mempool", d: "pending txs wait here" },
  { t: "Proposer", d: "picks txs, orders them" },
  { t: "New block", d: "appended to the chain" },
  { t: "State", d: "balances and storage update" },
];
---
<svg viewBox="0 0 640 150" role="img" aria-labelledby="txl-t" font-family="var(--mono)" font-size="11">
  <title id="txl-t">Transaction lifecycle: wallet signs, transaction waits in the mempool, a block proposer includes it, the block is appended, and the state is updated</title>
  <defs>
    <marker id="txl-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0 0L10 5L0 10z" fill="currentColor" />
    </marker>
  </defs>
  {steps.map((s, i) => (
    <g transform={`translate(${i * 128 + 4} 30)`}>
      <rect width="116" height="76" rx="8" fill="none" stroke="var(--border)" stroke-width="1.5" />
      <text x="58" y="26" text-anchor="middle" fill="currentColor" font-weight="600">{i + 1}. {s.t}</text>
      <text x="58" y="48" text-anchor="middle" fill="var(--muted-fg)">{s.d.split(" ").slice(0, Math.ceil(s.d.split(" ").length / 2)).join(" ")}</text>
      <text x="58" y="62" text-anchor="middle" fill="var(--muted-fg)">{s.d.split(" ").slice(Math.ceil(s.d.split(" ").length / 2)).join(" ")}</text>
    </g>
  ))}
  {[0, 1, 2, 3].map((i) => (
    <path d={`M${i * 128 + 120} 68 H${i * 128 + 130}`} fill="none" stroke="currentColor" stroke-width="1.5" marker-end="url(#txl-arrow)" />
  ))}
  <text x="4" y="132" fill="var(--muted-fg)">A reverted tx can still be included: its changes are undone, but gas is paid.</text>
</svg>
